# PostgreSQL / Neon. Use a pooled runtime URL and a direct URL for migrations.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
DIRECT_URL="postgresql://user:password@host/database?sslmode=require"

# 7 days by default.
AUTH_SESSION_MAX_AGE_SECONDS="604800"

# Vercel private Blob token. Required only by the evidence upload route.
BLOB_READ_WRITE_TOKEN=""

# Seed credentials. The seed command refuses to run when these are missing.
SEED_ADMIN_PASSWORD=""
SEED_MENTOR_PASSWORD=""
SEED_LEARNER_PASSWORD=""

# Optional: protect operational health details.
HEALTHCHECK_TOKEN=""
